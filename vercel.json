{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm ci --prefix jiosaavn-api --omit=dev --ignore-scripts && npm ci --prefix music-app --ignore-scripts",
  "buildCommand": "npm run build --prefix music-app",
  "outputDirectory": "music-app/dist",
  "functions": {
    "api/[...path].mjs": {
      "maxDuration": 60
    },
    "api/dl.mjs": {
      "maxDuration": 60
    },
    "api/ytaudio.mjs": {
      "maxDuration": 60
    },
    "api/ytmusic.mjs": {
      "maxDuration": 30
    },
    "api/search/[path].mjs": {
      "maxDuration": 60
    },
    "api/artists/[path].mjs": {
      "maxDuration": 60
    },
    "api/songs/[path].mjs": {
      "maxDuration": 60
    },
    "api/content/[path].mjs": {
      "maxDuration": 60
    },
    "api/canvas.mjs": {
      "maxDuration": 30
    },
    "api/import-playlist.mjs": {
      "maxDuration": 60
    },
    "api/apk.mjs": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/download/vibex.apk",
      "destination": "/api/apk"
    },
    {
      "source": "/dl",
      "destination": "/api/dl"
    },
    {
      "source": "/artist/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/album/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/playlist/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/search",
      "destination": "/index.html"
    },
    {
      "source": "/library",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/icons/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, immutable"
        }
      ]
    },
    {
      "source": "/splash/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, immutable"
        }
      ]
    }
  ]
}
