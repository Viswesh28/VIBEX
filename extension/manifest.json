{
  "manifest_version": 3,
  "name": "VIBEX stream helper",
  "version": "0.1.0",
  "description": "Mints YouTube audio URLs in your own browser for the VIBEX web player. Nothing leaves this machine.",
  "permissions": ["tabs", "scripting"],
  "host_permissions": ["*://*.googlevideo.com/*", "*://music.youtube.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://vibex-music-pi.vercel.app/*"],
      "js": ["app/page-hook.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["https://vibex-music-pi.vercel.app/*"],
      "js": ["app/bridge.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["*://music.youtube.com/*"],
      "js": ["yt/harvest.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["*://music.youtube.com/*"],
      "js": ["yt/relay.js"],
      "run_at": "document_start"
    }
  ]
}
