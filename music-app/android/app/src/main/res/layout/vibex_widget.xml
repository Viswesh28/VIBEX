<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp" android:background="#211B35">
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/app_name" android:textColor="#CABCFF" android:textSize="12sp"/>
<TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="17sp" android:maxLines="1" android:ellipsize="end" android:paddingTop="4dp" android:paddingBottom="4dp"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center">
<Button android:id="@+id/widget_prev" android:layout_width="64dp" android:layout_height="48dp" android:text="Ⅰ◀" android:contentDescription="Previous track"/>
<Button android:id="@+id/widget_play" android:layout_width="64dp" android:layout_height="48dp" android:text="▶" android:contentDescription="Play or pause"/>
<Button android:id="@+id/widget_next" android:layout_width="64dp" android:layout_height="48dp" android:text="▶Ⅰ" android:contentDescription="Next track"/>
</LinearLayout></LinearLayout>
